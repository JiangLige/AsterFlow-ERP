SERVER_PORT=3001

DB_URL=jdbc:mysql://localhost:3306/asterflow_erp?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DB_USERNAME=root
DB_PASSWORD=root
DB_DRIVER=com.mysql.cj.jdbc.Driver

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_TIMEOUT=3s

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-5-mini

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=24
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_API_BASE_URL=http://localhost:3001

SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# local：本地内存模式，适合本地开发。
# redis：Redis 模式，适合生产环境或多实例部署。
ERP_AUTH_SESSION_STORE=local
ERP_CACHE_TYPE=local
ERP_IDEMPOTENCY_STORE=local

# Dashboard 汇总缓存时间，单位：秒。
ERP_DASHBOARD_SUMMARY_TTL_SECONDS=60

# 商品详情缓存时间，单位：秒。
ERP_PRODUCT_DETAIL_TTL_SECONDS=300

# 不存在商品的空值缓存时间，单位：秒，用于降低缓存穿透。
ERP_PRODUCT_MISSING_TTL_SECONDS=30

# 商品布隆过滤器 Redis Bitmap Key。
ERP_PRODUCT_BLOOM_KEY=asterflow-erp:bloom:product

# 商品布隆过滤器位图大小。
ERP_PRODUCT_BLOOM_BITS=1000000

# Redis 限流开关。生产环境建议 true，本地开发可使用 false。
ERP_RATE_LIMIT_ENABLED=false

# 限流窗口时间，单位：秒。
ERP_RATE_LIMIT_WINDOW_SECONDS=60

# 登录接口限流：同一个 IP 在每个窗口内最多请求次数。
ERP_RATE_LIMIT_LOGIN_LIMIT=10

# 普通 API 限流：同一个用户或 IP 在每个窗口内最多请求次数。
ERP_RATE_LIMIT_API_LIMIT=120
